{
  "name": "mupen64plus-web",
  "version": "2.0.0",
  "description": "Emscripten based web port of Mupen64plus N64 Emulator",
  "main": "./bin/web/main.js",
  "types": "./scripts/main.d.ts",
  "scripts": {
    "test:extensive": "node ./node_modules/jest/bin/jest.js --selectProjects all-tests",
    "test": "node ./node_modules/jest/bin/jest.js --selectProjects release-browser-tests '--use-pre-existing-build=true'",
    "release": "make clean-web && make config=release -j8 && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cheinr/mupen64plus-web"
  },
  "license": "GPL-2.0",
  "devDependencies": {
    "@babel/preset-env": "^7.25.4",
    "jest": "^29.7.0",
    "jest-image-snapshot": "^6.4.0",
    "jest-serial-runner": "^1.2.1",
    "puppeteer": "^23.4.1",
    "yargs": "^17.2.0"
  },
  "dependencies": {
    "axios": "^1.1.3"
  }
}
